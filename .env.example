# Copie para .env e ajuste. Todos os valores abaixo são os padrões usados
# quando a variável não é definida — servem para desenvolvimento, NÃO para produção.

# Portas expostas no host (padrões pouco comuns, para não colidir com outras aplicações)
WEB_PORT=3005
APP_PORT=8089
# Só usada com docker-compose.dev.yml (Postgres exposto para a IDE)
DB_PORT=5432

# Banco
DB_PASSWORD=prova

# Perfil Spring: "dev" carrega pessoas de exemplo; deixe vazio para começar sem dados
SPRING_PROFILES_ACTIVE=dev

# Autenticação (ADR 0008). A interface usa estas mesmas credenciais no login
# automático (ADR 0012): elas são embutidas no JavaScript no build do frontend.
ADMIN_USUARIO=admin
ADMIN_SENHA=admin123
# Mínimo de 32 caracteres. Gere um aleatório, p.ex.: openssl rand -base64 48
JWT_SEGREDO=dev-only-troque-este-segredo-com-32+-caracteres

# Origens do navegador autorizadas (separadas por vírgula)
CORS_ORIGENS=http://localhost:5173

# Chave da nationalize.io (opcional). Sem ela, a cota gratuita é de só 10 consultas.
# Crie uma chave grátis em https://nationalize.io e cole aqui.
NATIONALIZE_API_KEY=
